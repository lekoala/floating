{
  "name": "@lekoala/floating",
  "version": "0.1.0",
  "description": "Small zero-dependency positioning engine for floating browser UI",
  "type": "module",
  "license": "MIT",
  "author": "LeKoala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekoala/floating.git"
  },
  "homepage": "https://github.com/lekoala/floating",
  "bugs": {
    "url": "https://github.com/lekoala/floating/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/floating.d.ts",
      "import": "./src/floating.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "test:node": "node --test",
    "types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "check": "bun run typecheck && bun run test && bun run test:node && bun run lint && bun run types",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.0"
  },
  "packageManager": "bun@1.4.0",
  "types": "./types/floating.d.ts"
}
